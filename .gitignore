# ---- 依赖与构建产物 ----
node_modules/
dist/
.gradle/
build/
local.properties
captures/

# ---- 编辑器 / 系统 ----
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ---- 临时与备份目录（不入库）----
.tmp-check/
.agent-runs/

# ---- 签名文件绝对不要提交 ----
*.jks
*.keystore

# ---- Gradle wrapper 二进制（由 IDE 或 CI 生成）----
gradlew
gradlew.bat
gradle/wrapper/gradle-wrapper.jar

# ---- 安卓 assets 由 CI 从 java-learning-app/dist 构建后拷贝，不入库 ----
# （android-shell/.gitignore 里已有同样规则，这里重复一次以防单独提交 android-shell）
android-shell/app/src/main/assets/*
!android-shell/app/src/main/assets/README.txt
