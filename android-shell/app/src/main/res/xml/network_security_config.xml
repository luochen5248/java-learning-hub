<?xml version="1.0" encoding="utf-8"?>
<!--
  本应用只加载本地 assets（经 WebViewAssetLoader 映射到
  https://appassets.androidplatform.net/assets/ 加载），不需要任何网络放行。
  这里保留配置文件是为了两种可选场景：
  1. 课程内容里引用了在线字体 / 在线接口时，需要允许明文（http）流量；
  2. 某些定制 WebView 在 file:// 下发起请求时会被默认策略拦截。

  正式上架前若不需要联网，可以直接删掉本文件并移除 manifest 中的
  android:networkSecurityConfig 属性。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- 仅对本机调试放开明文流量，生产建议保持 false -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>