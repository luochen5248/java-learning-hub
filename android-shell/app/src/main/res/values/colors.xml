<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      浅色主题（默认，values/）。深色值在 values-night/colors.xml。
      三组底色/文字色与 web 端 css/app.css 的
        [data-theme='light'] { --bg / --panel / --text }
      保持一致，避免 WebView 加载前后出现色差。
    -->
    <color name="bg_root">#F7F9FD</color>
    <color name="bg_panel">#FFFFFF</color>
    <color name="text_primary">#0F1E36</color>

    <!-- 点缀色三角（浅色版，对应 css 的 --blue / --cyan / --gold） -->
    <color name="brand_blue">#2563EB</color>
    <color name="brand_cyan">#0891B2</color>
    <color name="brand_gold">#D97706</color>

    <!-- 自适应图标的背景层（必须是纯色，图标本体在 drawable/ic_launcher_foreground.xml）
         图标属于品牌资产，不随系统深浅色变化，故只在 values/ 定义一次。 -->
    <color name="ic_launcher_background">#0F1B2D</color>
</resources>
